#!/bin/bash
# Removes the KWin window rules that XMacTahoe 1.6.0 - 1.8.1 created.
# Those rules forced the theme's title bar on Chrome and Electron apps; apps that draw their own
# title bar (Chrome, VS Code, Spotify...) then showed two bars. Each app now picks its own
# decoration: Chrome keeps its tab strip with its buttons, apps that ask for it get the theme's
# traffic lights. Tip: Chrome → Settings → Appearance → Theme "GTK" draws MacTahoe-style buttons.
python3 - <<'PY'
import os, re
p = os.path.expanduser('~/.config/kwinrulesrc')
if not os.path.exists(p): raise SystemExit
t = open(p).read()
secs = re.split(r'(?m)^(?=\[)', t)
keep = [s for s in secs if not s.startswith('[xmactahoe-')]
removed = len(secs) - len(keep)
out = ''.join(keep)
ids = [s[1:s.index(']')] for s in keep if s.startswith('[') and not s.startswith('[General]')]
out = re.sub(r'(?m)^rules=.*$', 'rules=' + ','.join(ids), out)
out = re.sub(r'(?m)^count=.*$', 'count=%d' % len(ids), out)
open(p, 'w').write(out)
print(f'✓ {removed} XMacTahoe window rule(s) removed; apps choose their own title bar')
PY
gdbus call --session --dest org.kde.KWin --object-path /KWin --method org.kde.KWin.reconfigure >/dev/null 2>&1
