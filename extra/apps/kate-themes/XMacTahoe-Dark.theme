    },
    "Documentation": {
      "text-color": "#6c7986",
      "italic": true
    },
    "Annotation": {
      "text-color": "#6c7986"
    },
    "CommentVar": {
      "text-color": "#6c7986"
    },
    "RegionMarker": {
      "text-color": "#41a1c0",
