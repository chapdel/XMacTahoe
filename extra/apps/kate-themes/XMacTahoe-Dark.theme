    "CodeFolding": "#2c2c33",
    "CurrentLine": "#2a2a30",
    "CurrentLineNumber": "#d0d0d0",
    "IconBorder": "#1f1f24",
    "IndentationLine": "#3a3a40",
    "LineNumbers": "#6b6b70",
    "MarkBookmark": "#0a84ff",
    "MarkBreakpointActive": "#ff453a",
    "MarkBreakpointDisabled": "#8e8e93",
    "MarkBreakpointReached": "#ffd60a",
    "MarkError": "#ff453a",
    "MarkExecution": "#30d158",
    "MarkWarning": "#ff9f0a",
    "ModifiedLines": "#ff9f0a",
    "ReplaceHighlight": "#30d158",
    "SavedLines": "#30d158",
    "SearchHighlight": "#ffd60a",
    "Separator": "#3a3a40",
    "SpellChecking": "#ff453a",
    "TabMarker": "#3a3a40",
    "TemplateBackground": "#2a2a30",
    "TemplateFocusedPlaceholder": "#0a84ff",
    "TemplatePlaceholder": "#2a2a30",
    "TemplateReadOnlyPlaceholder": "#2a2a30",
    "TextSelection": "#3f5f8f",
    "WordWrapMarker": "#3a3a40"
  },
  "text-styles": {
    "Normal": {
      "text-color": "#ffffff"
    },
    "Keyword": {
      "text-color": "#fc5fa3",
      "bold": true
    },
