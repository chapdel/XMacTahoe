#!/bin/bash
# Applies macOS Tahoe-style rounded corners (KWin effect "KDE Rounded Corners").
# Installs the package when missing (COPR matinlotfali/KDE-Rounded-Corners, sudo required),
# writes the settings to kwinrc and (re)loads the effect live.
PKG=$(cat "$HOME/.config/xmactahoe/package-dir" 2>/dev/null); D="${PKG:+$PKG/extra}"; [ -f "$D/kwinrc-round-corners.conf" ] || D="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
if ! rpm -q kwin-effect-roundcorners >/dev/null 2>&1; then
  echo "→ Installing kwin-effect-roundcorners (COPR matinlotfali/KDE-Rounded-Corners)"
  sudo dnf copr enable -y matinlotfali/KDE-Rounded-Corners && sudo dnf install -y kwin-effect-roundcorners \
    || { echo "⚠ Install failed: rounded corners not applied."; exit 1; }
fi
# settings: every key=value line of the .conf file, per group
group=""
while IFS= read -r line; do
  case "$line" in
    \[*\]) group="${line#[}"; group="${group%]}" ;;
    *=*) [ -n "$group" ] && kwriteconfig6 --file kwinrc --group "$group" --key "${line%%=*}" "${line#*=}" ;;
  esac
done < "$D/kwinrc-round-corners.conf"
# macOS-like animations and hot corners (magic lamp, desktop top right, overview top left)
group=""
while IFS= read -r line; do
  case "$line" in
    \[*\]) group="${line#[}"; group="${group%]}" ;;
    *=*) [ -n "$group" ] && kwriteconfig6 --file kwinrc --group "$group" --key "${line%%=*}" "${line#*=}" ;;
  esac
done < "$D/kwinrc-effects.conf"
gdbus call --session --dest org.kde.KWin --object-path /KWin --method org.kde.KWin.reconfigure >/dev/null 2>&1
# full reload: a plain reconfigure does not re-read this effect's config
gdbus call --session --dest org.kde.KWin --object-path /Effects --method org.kde.kwin.Effects.unloadEffect kwin4_effect_shapecorners >/dev/null 2>&1
sleep 1
gdbus call --session --dest org.kde.KWin --object-path /Effects --method org.kde.kwin.Effects.loadEffect kwin4_effect_shapecorners >/dev/null 2>&1
echo "✓ Rounded corners active (radius $(kreadconfig6 --file kwinrc --group Round-Corners --key Size) px)"
