#!/usr/bin/env python3
"""Menu bar and dock on every screen.

Plasma pins a panel to one screen and cannot duplicate or move it by itself, so plugging a second
screen in leaves it bare. `clone` copies the bar and the dock of a screen that has them - widgets,
settings and all - onto the screens that have none, live, without restarting plasmashell.

This runs by itself: the user unit `xmactahoe-panels.path` watches KWin's output configuration, so
a screen plugged in gets its panels a few seconds later. Unplugging needs nothing: Plasma keeps the
panels in its configuration and brings them back when the screen returns.

Usage: xmactahoe-panels [status|clone|swap OLD NEW] [--location bottom] [--dry-run] [--quiet]
  status  list the panels of each screen
  clone   give every screen without panels its own copy
  swap    rebuild the panels, replacing widget OLD with widget NEW and keeping every setting
  magnify dock icon magnification under the pointer: on, off, a percentage (110-200), or status.
          `on` swaps Plasma's task widget for the theme's dock widget, `off` puts it back.

The AppGrid widget is not copied: the Meta shortcut needs a single live widget.
`install.sh --layout` already creates the panels on every screen connected at the time.
"""
import json, os, re, subprocess, sys

CFG = os.path.expanduser('~/.config')
APPLETS = f'{CFG}/plasma-org.kde.plasma.desktop-appletsrc'
SKIP_PLUGINS = {'dev.xarbit.appgrid'}
# written by the panel itself, not by its applets
APPLET_SKIP_KEYS = {'activityId', 'formfactor', 'immutability', 'lastScreen', 'location', 'plugin', 'wallpaperplugin'}
PANEL_PROPS = ['location', 'alignment', 'hiding', 'lengthMode', 'opacity', 'floating', 'height', 'offset',
               'minimumLength', 'maximumLength']
QUIET = False


def say(*a):
    if not QUIET: print(*a)


def pscript(js):
    # gdbus parses the argument as GVariant text, so hand it a quoted GVariant string, not raw JavaScript
    arg = '"' + js.replace('\\', '\\\\').replace('"', '\\"').replace('\n', '\\n') + '"'
    r = subprocess.run(['gdbus', 'call', '--session', '--dest', 'org.kde.plasmashell',
                        '--object-path', '/PlasmaShell', '--method',
                        'org.kde.PlasmaShell.evaluateScript', arg], capture_output=True, text=True)
    return r.stdout + r.stderr


def live():
    """(screen widths, panels) as plasmashell sees them, or (None, None) when it does not answer."""
    props = ' '.join(f'+" {p}="+p.{p}' for p in PANEL_PROPS)
    out = pscript('var s=[]; for (var i=0;i<screenCount;i++){ var g=screenGeometry(i); s.push("S "+i+" "+g.width); }'
                  ' var ps=panels(); for (var i=0;i<ps.length;i++){ var p=ps[i]; s.push("P id="+p.id+" screen="+p.screen'
                  + props + '); } print(s.join(" ;; "));')
    if ' ;; ' not in out and 'S ' not in out: return None, None
    widths, panels = {}, []
    for part in out.split(' ;; '):
        part = part.strip(" ('),\n")
        f = part.split()
        if len(f) == 3 and f[0] == 'S':
            widths[int(f[1])] = int(f[2])
        elif f and f[0] == 'P':
            d = dict(kv.split('=', 1) for kv in f[1:] if '=' in kv)
            d['id'], d['screen'] = int(d['id']), int(d['screen'])
            panels.append(d)
    return widths, panels


def applets_of(containment):
    """[(plugin, {group tuple: {key: value}}, {root key: value})] in panel order, from the config file."""
    blocks, cur = {}, None
    for line in open(APPLETS):
        line = line.rstrip('\n')
        if line.startswith('['):
            cur = blocks.setdefault(line, [])
        elif cur is not None and '=' in line:
            cur.append(line.split('=', 1))
    order = dict(blocks.get(f'[Containments][{containment}][General]', [])).get('AppletOrder', '')
    out = []
    for aid in [a for a in order.split(';') if a]:
        base = f'[Containments][{containment}][Applets][{aid}]'
        root = dict(blocks.get(base, []))
        plugin = root.pop('plugin', None)
        if not plugin or plugin in SKIP_PLUGINS: continue
        root = {k: v for k, v in root.items() if k not in APPLET_SKIP_KEYS}
        # (a containment-like applet keeps these at its base, a plain one under [Configuration])
        groups = {}
        for head, pairs in blocks.items():
            m = re.fullmatch(re.escape(base) + r'((?:\[[^\]]+\])+)', head)
            if not m: continue
            path = re.findall(r'\[([^\]]+)\]', m.group(1))
            # a plain applet keeps its settings under [Configuration]; a containment-like one
            # (the system tray) keeps them directly, and its nested applets are not ours to copy
            if path[0] == 'Applets': continue
            if path[0] == 'Shortcuts': continue      # a global shortcut belongs to one widget, not to its copies
            if path[0] == 'Configuration': path = path[1:]
            if path: groups[tuple(path)] = dict(pairs)
            else: root.update(pairs)                 # keys right under [Configuration] (popup size...)
        out.append((plugin, groups, root))
    return out


def clone_js(source, screen, width, swap=None):
    """JavaScript that recreates `source` (a live panel dict) on `screen`, optionally swapping plugins."""
    js = ['var p = new Panel("org.kde.panel");']
    for prop in PANEL_PROPS:
        v = source.get(prop)
        if v is None: continue
        if prop in ('minimumLength', 'maximumLength') and width: v = str(width)
        js.append(f'p.{prop} = ' + (v if v in ('true', 'false') or re.fullmatch(r'-?\d+', v) else json.dumps(v)) + ';')
    js.append(f'p.screen = {screen};')
    for plugin, groups, root in applets_of(source['id']):
        plugin = (swap or {}).get(plugin, plugin)
        js.append(f'var w = p.addWidget({json.dumps(plugin)});')
        for key, val in root.items():
            js.append(f'w.currentConfigGroup = []; w.writeConfig({json.dumps(key)}, {json.dumps(val)});')
        for group, pairs in groups.items():
            js.append('w.currentConfigGroup = ' + json.dumps(list(group)) + ';')
            for key, val in pairs.items():
                js.append(f'w.writeConfig({json.dumps(key)}, {json.dumps(val)});')
    js.append('print("PANEL " + p.id);')
    return '\n'.join(js)


DOCK_WIDGET = 'org.xmactahoe.dock'
STOCK_WIDGET = 'org.kde.plasma.icontasks'
DOCK_THICKNESS = {True: 84, False: 66}   # magnified icons need room above the row


def dock_widgets_js(body):
    return ('var out=[]; for (var i=0;i<panelIds.length;i++){ var p=panelById(panelIds[i]);'
            ' if (p.location!="bottom") continue; var ws=p.widgets();'
            ' for (var j=0;j<ws.length;j++){ var w=ws[j]; if (w.type!="%s") continue;'
            ' w.currentConfigGroup=["General"]; %s } } print(out.join(","));' % (DOCK_WIDGET, body))


def magnify(arg, args):
    if arg == 'status':
        out = pscript(dock_widgets_js('var m=w.readConfig("magnification")+""; var f=w.readConfig("magnificationFactor")+"";'
                                      ' out.push(m=="false" ? "off" : ((f||"135")+" %"));'))
        states = [x for x in re.findall(r'off|\d+ %', out)]
        print(states[0] if states else 'off (Plasma\'s own task widget is in the dock)')
        return
    if arg in ('on', 'off'):
        old, new = (STOCK_WIDGET, DOCK_WIDGET) if arg == 'on' else (DOCK_WIDGET, STOCK_WIDGET)
        sys.argv = ['x', 'swap', old, new, '--location', 'bottom'] + (['--quiet'] if QUIET else [])
        widths, panels = live()
        for src in [p for p in panels if p['location'] == 'bottom']:
            if not any(plug == old for plug, _, _ in applets_of(src['id'])): continue
            out = pscript(clone_js(src, src['screen'], widths.get(src['screen']), {old: new}))
            m = re.search(r'PANEL (\d+)', out)
            if not m: print(f'⚠ panel {src["id"]}: {out.strip()[:160]}', file=sys.stderr); continue
            pscript(f'panelById({src["id"]}).remove(); panelById({m.group(1)}).height = {DOCK_THICKNESS[arg == "on"]}; print("ok");')
            say(f'✓ screen {src["screen"]}: dock rebuilt with {new}')
        if arg == 'on': pscript(dock_widgets_js('w.writeConfig("magnification","true"); w.reloadConfig();'))
        say(f'dock magnification: {arg}')
        return
    if re.fullmatch(r'\d+', arg):
        factor = max(100, min(200, int(arg)))
        pscript(dock_widgets_js(f'w.writeConfig("magnification","true"); w.writeConfig("magnificationFactor","{factor}"); w.reloadConfig();'))
        say(f'dock magnification: {factor} %')
        return
    print(__doc__); sys.exit(1)


def main():
    global QUIET
    args = sys.argv[1:]
    QUIET = '--quiet' in args
    mode = next((a for a in args if not a.startswith('-')), 'status')
    if mode not in ('status', 'clone', 'swap', 'magnify'): print(__doc__); sys.exit(1)
    widths, panels = live()
    if panels is None:
        say('plasmashell does not answer on D-Bus'); sys.exit(0 if QUIET else 1)
    if mode == 'magnify':
        rest = [a for a in args if not a.startswith('-')][1:]
        magnify(rest[0] if rest else 'status', args); return
    if mode == 'swap':
        skip = args.index('--location') + 1 if '--location' in args else -1
        rest = [a for i, a in enumerate(args) if not a.startswith('-') and i != skip][1:]
        if len(rest) != 2: print(__doc__); sys.exit(1)
        old, new = rest
        where = args[args.index('--location') + 1] if '--location' in args else None
        targets = [p for p in panels if (not where or p['location'] == where)]
        for src in targets:
            if not any(plug == old for plug, _, _ in applets_of(src['id'])):
                continue
            js = clone_js(src, src['screen'], widths.get(src['screen']), {old: new})
            if '--dry-run' in args:
                print(f'--- panel {src["id"]} (screen {src["screen"]}, {src["location"]}) rebuilt with {new}'); continue
            out = pscript(js)
            m = re.search(r'PANEL (\d+)', out)
            if not m:
                print(f'⚠ panel {src["id"]}: rebuild failed: {out.strip()[:200]}', file=sys.stderr); continue
            pscript(f'panelById({src["id"]}).remove(); print("REMOVED");')
            say(f'✓ screen {src["screen"]}: {src["location"]} panel rebuilt as {m.group(1)} with {new}')
        return
    by_screen = {}
    for p in panels: by_screen.setdefault(p['screen'], []).append(p)
    if mode == 'status':
        for s in sorted(widths):
            got = by_screen.get(s, [])
            print(f'  screen {s} ({widths[s]}px): ' + (', '.join(f"{p['location']} panel {p['id']}" for p in got) or 'no panel'))
        if [s for s in widths if s not in by_screen]: print('  → give them a bar and a dock with: xmactahoe panels clone')
        return
    missing = [s for s in sorted(widths) if not by_screen.get(s)]
    if not missing:
        say('every screen already has its panels'); return
    full = [s for s in sorted(by_screen) if {p['location'] for p in by_screen[s]} >= {'top', 'bottom'}]
    if not full:
        say('no screen has both a bar and a dock to copy from (install.sh --layout creates them)'); sys.exit(1)
    dry = '--dry-run' in args
    for screen in missing:
        for location in ('top', 'bottom'):
            # a panel Plasma pushed onto another screen when its own went away: move it back
            spare = next((p for s in sorted(by_screen)
                          for p in by_screen[s][1:] if p['location'] == location
                          and len([q for q in by_screen[s] if q['location'] == location]) > 1), None)
            if spare:
                say(f'→ screen {screen}: moving the spare {location} panel {spare["id"]} back')
                if not dry:
                    pscript(f'panelById({spare["id"]}).screen = {screen}; print("MOVED");')
                    by_screen[spare['screen']].remove(spare); spare['screen'] = screen
                    by_screen.setdefault(screen, []).append(spare)
                continue
            src = next(p for p in by_screen[full[0]] if p['location'] == location)
            js = clone_js(src, screen, widths.get(screen))
            if dry:
                print(f'--- screen {screen}, copy of panel {src["id"]} ({location}), {js.count("addWidget")} widgets')
                continue
            out = pscript(js)
            m = re.search(r'PANEL (\d+)', out)
            if m: say(f'✓ screen {screen}: {location} panel {m.group(1)} created from {src["id"]}')
            else: print(f'⚠ screen {screen}: could not create the {location} panel: {out.strip()[:200]}', file=sys.stderr)


main()
