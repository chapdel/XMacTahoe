      "text-color": "#67b7a4"
    },
    "Variable": {
      "text-color": "#41a1c0"
    },
    "ControlFlow": {
      "text-color": "#fc5fa3",
      "bold": true
    },
    "Operator": {
      "text-color": "#ffffff"
    },
    "BuiltIn": {
      "text-color": "#d0a8ff"
    },
    "Extension": {
      "text-color": "#67b7a4"
    },
    "Preprocessor": {
      "text-color": "#fd8f3f"
    },
    "Attribute": {
      "text-color": "#41a1c0"
    },
    "Char": {
      "text-color": "#fc6a5d"
    },
    "SpecialChar": {
      "text-color": "#fc6a5d"
    },
    "String": {
      "text-color": "#fc6a5d"
    },
    "VerbatimString": {
      "text-color": "#fc6a5d"
    },
    "SpecialString": {
      "text-color": "#fc6a5d"
    },
    "Import": {
      "text-color": "#fc5fa3"
    },
    "DataType": {
      "text-color": "#5dd8ff"
    },
    "DecVal": {
      "text-color": "#d0bf69"
    },
    "BaseN": {
      "text-color": "#d0bf69"
    },
    "Float": {
      "text-color": "#d0bf69"
    },
    "Constant": {
      "text-color": "#d0a8ff"
    },
    "Comment": {
      "text-color": "#6c7986",
