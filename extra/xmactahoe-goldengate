#!/bin/bash
# The macOS Golden Gate (macOS 27) traits, on top of the Tahoe look this theme is built on:
#   - glass tinted rather than fully transparent (its Liquid Glass slider), level 55
#   - one corner radius for every window, a little squarer: 12 px instead of 18
#   - the active window stands out: inactive ones are dimmed slightly
#   - crisper glass edges: more contrast, more saturation, brighter edge lighting
#   - window buttons in Liquid Glass, unless you set them yourself with `xmactahoe buttons`
# Usage: xmactahoe-goldengate on|off|status      (off restores the Tahoe values)
set -uo pipefail
D="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
ST="$HOME/.config/xmactahoe"; mkdir -p "$ST"
k() { kwriteconfig6 --file kwinrc "$@" 2>/dev/null; }
kwin_reconfigure() { gdbus call --session --dest org.kde.KWin --object-path /KWin --method org.kde.KWin.reconfigure >/dev/null 2>&1; }
fx() { gdbus call --session --dest org.kde.KWin --object-path /Effects --method "org.kde.kwin.Effects.$1" "$2" >/dev/null 2>&1; }
buttons() {   # the window buttons are a choice of their own: a preset only sets them by default
  [ -f "$ST/buttons" ] && return 0
  "$D/xmactahoe-buttons" "$1" --preset >/dev/null 2>&1
}

case "${1:-status}" in
  on)
    "$D/xmactahoe-glass-level" 55 --quiet
    "$D/xmactahoe-round-corners" 12 >/dev/null
    k --group Plugins --key diminactiveEnabled true
    k --group Effect-diminactive --key Strength 10
    for key in DimPanels DimKeepAbove DimFullScreen DimByGroup; do k --group Effect-diminactive --key "$key" false; done
    k --group Effect-blurplus --key Contrast 1.08
    k --group Effect-blurplus --key Saturation 1.4
    k --group Effect-blurplus --key GlowColor "#E6FFFFFF"
    buttons glass                    # unless you chose otherwise with: xmactahoe buttons
    kwin_reconfigure; fx loadEffect diminactive
    echo goldengate > "$ST/preset"
    echo "✓ Golden Gate: glass 55 %, corners 12 px, inactive windows dimmed, crisper glass edges"
    echo "  back to Tahoe: xmactahoe goldengate off" ;;
  off)
    "$D/xmactahoe-glass-level" 100 --quiet
    "$D/xmactahoe-round-corners" 18 >/dev/null
    k --group Plugins --key diminactiveEnabled false
    k --group Effect-diminactive --key Strength --delete
    k --group Effect-blurplus --key Contrast 1.0
    k --group Effect-blurplus --key Saturation 1.3
    k --group Effect-blurplus --key GlowColor "#B3FFFFFF"
    buttons flat                     # unless you chose otherwise with: xmactahoe buttons
    kwin_reconfigure; fx unloadEffect diminactive
    echo tahoe > "$ST/preset"
    echo "✓ Tahoe: glass 100 %, corners 18 px, no dimming" ;;
  status)
    echo "preset: $(cat "$ST/preset" 2>/dev/null || echo tahoe)"
    echo "glass level: $("$D/xmactahoe-glass-level")%"
    echo "corner radius: $(kreadconfig6 --file kwinrc --group Round-Corners --key Size) px"
    echo "dim inactive: $(kreadconfig6 --file kwinrc --group Plugins --key diminactiveEnabled 2>/dev/null || echo false)"
    echo "window buttons: $("$D/xmactahoe-buttons" status)" ;;
  *) sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
