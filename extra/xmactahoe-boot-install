#!/bin/bash
# Installs the "xmactahoe" Plymouth boot theme (Apple-style logo + spinner, black background).
# Run with sudo: rebuilds the initramfs (dracut), allow about a minute.
set -e
D="$(cd "$(dirname "$0")" && pwd)"
[ "$(id -u)" = 0 ] || { echo "Run with sudo: sudo $0"; exit 1; }
rm -rf /usr/share/plymouth/themes/xmactahoe
cp -r "$D/plymouth/xmactahoe" /usr/share/plymouth/themes/xmactahoe
plymouth-set-default-theme -R xmactahoe
echo "✓ Plymouth: xmactahoe theme active (visible at next boot)."
