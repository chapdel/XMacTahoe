#!/usr/bin/env python3
"""macOS-like "Auto" appearance: light after sunrise, dark after sunset.
Location: ~/.config/xmactahoe/location (two numbers: latitude longitude), otherwise KWin Night Light's
auto-detected coordinates (kwinrc [NightColor] LatitudeAuto/LongitudeAuto), otherwise nothing happens.
Run by xmactahoe-appearance.timer every 10 minutes. It switches once per sunrise/sunset: the last event
applied is kept in ~/.config/xmactahoe/appearance-event, so a manual toggle in Flex Hub is respected until
the next event, and an event missed while the machine was asleep or off is caught up on the next run.
Usage: xmactahoe-auto-appearance [--now]   (--now applies the expected variant immediately)
"""
import math, os, sys, subprocess, datetime
def location():
    p = os.path.expanduser('~/.config/xmactahoe/location')
    if os.path.exists(p):
        a, b = open(p).read().split()[:2]; return float(a), float(b)
    # kreadconfig6, not configparser: KDE files hold keys like "InputMethod[$d]" that configparser rejects
    def k(key):
        r = subprocess.run(['kreadconfig6', '--file', 'kwinrc', '--group', 'NightColor', '--key', key], capture_output=True, text=True)
        return r.stdout.strip()
    try: return float(k('LatitudeAuto')), float(k('LongitudeAuto'))
    except (ValueError, OSError): return None
def sun_events(lat, lon, day):
    """NOAA approximation: returns (sunrise, sunset) as aware local datetimes."""
    n = day.timetuple().tm_yday
    def ev(rising):
        lngHour = lon / 15.0; t = n + ((6 if rising else 18) - lngHour) / 24.0
        M = (0.9856 * t) - 3.289
        L = (M + 1.916 * math.sin(math.radians(M)) + 0.020 * math.sin(math.radians(2 * M)) + 282.634) % 360
        RA = math.degrees(math.atan(0.91764 * math.tan(math.radians(L)))) % 360
        RA = (RA + (math.floor(L / 90) * 90 - math.floor(RA / 90) * 90)) / 15.0
        sinDec = 0.39782 * math.sin(math.radians(L)); cosDec = math.cos(math.asin(sinDec))
        cosH = (math.cos(math.radians(90.833)) - sinDec * math.sin(math.radians(lat))) / (cosDec * math.cos(math.radians(lat)))
        if cosH > 1 or cosH < -1: return None
        H = (360 - math.degrees(math.acos(cosH))) if rising else math.degrees(math.acos(cosH)); H /= 15.0
        T = H + RA - 0.06571 * t - 6.622; UT = (T - lngHour) % 24
        utc = datetime.datetime.combine(day, datetime.time(0), tzinfo=datetime.timezone.utc) + datetime.timedelta(hours=UT)
        return utc.astimezone()
    return ev(True), ev(False)
def current():
    try: return open(os.path.expanduser('~/.config/kdedefaults/package')).read().strip()
    except OSError: return ''
def apply(v):
    if current() != v:
        subprocess.run(['plasma-apply-lookandfeel', '-a', v], capture_output=True); print('switched to', v)
loc = location()
if not loc:
    print('no location: write "LATITUDE LONGITUDE" to ~/.config/xmactahoe/location (or enable automatic Night Light location)', file=sys.stderr)
    sys.exit(0)
now = datetime.datetime.now().astimezone()
# most recent sunrise/sunset not after now (today, else yesterday; polar day/night: no event, nothing to do)
events = []
for day in (now.date() - datetime.timedelta(days=1), now.date()):
    rise, set_ = sun_events(*loc, day)
    events += [(t, v) for t, v in ((rise, 'XMacTahoe.Light'), (set_, 'XMacTahoe.Dark')) if t and t <= now]
if not events: sys.exit(0)
when, expected = max(events)
state = os.path.expanduser('~/.config/xmactahoe/appearance-event'); event_id = when.strftime('%Y-%m-%dT%H:%M')
try: last = open(state).read().strip()
except OSError: last = None   # first run (e.g. after an upgrade): remember the event, keep the current variant
if '--now' in sys.argv or (last is not None and last != event_id): apply(expected)
if last != event_id:
    os.makedirs(os.path.dirname(state), exist_ok=True)
    with open(state, 'w') as f: f.write(event_id + '\n')
