#!/bin/bash
# Aligns Kvantum (Qt application style) and GTK with the active XMacTahoe
# global theme variant (light or dark). Run automatically by
# xmactahoe-variant.path whenever ~/.config/kdedefaults/package changes.
PKG=$(cat "$HOME/.config/kdedefaults/package" 2>/dev/null)
case "$PKG" in
  XMacTahoe.Light) KV=XMacTahoe;     GTKDARK=false; GS=prefer-light; GTKTHEME=MacTahoe-Light; ICONS=XMacTahoe-Day; CARD="#000000"; CARDOP=8 ;;
  XMacTahoe.Dark)  KV=XMacTahoeDark; GTKDARK=true;  GS=prefer-dark;  GTKTHEME=MacTahoe-Dark;  ICONS=XMacTahoe-Night; CARD="#ffffff"; CARDOP=14 ;;
  *) exit 0 ;;
esac
# Control Center cards: white on dark, a light shade of black on light (a fixed white washes out the light variant)
gdbus call --session --dest org.kde.plasmashell --object-path /PlasmaShell --method org.kde.PlasmaShell.evaluateScript \
  "for (var i=0;i<panelIds.length;i++){ var ws=panelById(panelIds[i]).widgets(); for (var j=0;j<ws.length;j++){ var w=ws[j];
     if (w.type!='Plasma.Flex.Hub') continue; w.currentConfigGroup=['General'];
     if (w.readConfig('customCardColor')+'' != '$CARD') { w.writeConfig('customCardColor','$CARD'); w.writeConfig('opacityCardCustom','$CARDOP'); w.reloadConfig(); } }}" >/dev/null 2>&1
CUR=$(sed -n 's/^theme=//p' "$HOME/.config/Kvantum/kvantum.kvconfig" 2>/dev/null)
if [ "$CUR" != "$KV" ]; then
  printf '[General]\ntheme=%s\n' "$KV" > "$HOME/.config/Kvantum/kvantum.kvconfig"
fi
# Kate / KWrite: Xcode-like color theme matching the variant (new windows)
KT="XMacTahoe $( [ "$KV" = XMacTahoe ] && echo Light || echo Dark )"
for rc in katerc kwriterc; do kwriteconfig6 --file "$rc" --group "KTextEditor Renderer" --key "Auto Color Theme Selection" false; kwriteconfig6 --file "$rc" --group "KTextEditor Renderer" --key "Color Theme" "$KT"; done
# Konsole: Terminal.app-like palette matching the variant (new windows)
KP="$HOME/.local/share/konsole/macOS.profile"; [ -f "$KP" ] && sed -i "s/^ColorScheme=.*/ColorScheme=$( [ "$KV" = XMacTahoe ] && echo XMacTahoe-Light || echo XMacTahoe )/" "$KP"
for v in gtk-3.0 gtk-4.0; do
  f="$HOME/.config/$v/settings.ini"; [ -f "$f" ] || continue
  grep -q '^gtk-application-prefer-dark-theme=' "$f" \
    && sed -i "s/^gtk-application-prefer-dark-theme=.*/gtk-application-prefer-dark-theme=$GTKDARK/" "$f" \
    || printf 'gtk-application-prefer-dark-theme=%s\n' "$GTKDARK" >> "$f"
done
for v in gtk-3.0 gtk-4.0; do
  f="$HOME/.config/$v/settings.ini"; [ -f "$f" ] || { mkdir -p "$HOME/.config/$v"; printf '[Settings]\n' > "$f"; }
  for kv in "gtk-theme-name=$GTKTHEME" "gtk-icon-theme-name=$ICONS"; do
    grep -q "^${kv%%=*}=" "$f" && sed -i "s/^${kv%%=*}=.*/$kv/" "$f" || echo "$kv" >> "$f"
  done
done
# libadwaita (GTK 4): the theme is copied into ~/.config/gtk-4.0
if [ -d "$HOME/.themes/$GTKTHEME/gtk-4.0" ]; then
  mkdir -p "$HOME/.config/gtk-4.0"; rm -rf "$HOME/.config/gtk-4.0/assets" "$HOME/.config/gtk-4.0/windows-assets"
  cp -a "$HOME/.themes/$GTKTHEME/gtk-4.0/." "$HOME/.config/gtk-4.0/"
fi
command -v flatpak >/dev/null && flatpak override --user --env=GTK_THEME="$GTKTHEME" 2>/dev/null
if command -v gsettings >/dev/null; then
  gsettings set org.gnome.desktop.interface color-scheme "$GS" 2>/dev/null
  gsettings set org.gnome.desktop.interface gtk-theme "$GTKTHEME" 2>/dev/null
  gsettings set org.gnome.desktop.interface icon-theme "$ICONS" 2>/dev/null
fi
logger -t xmactahoe "variant $PKG: Kvantum=$KV GTK=$GTKTHEME icons=$ICONS"
