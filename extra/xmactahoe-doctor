#!/bin/bash
# Checks the XMacTahoe installation; --fix repairs what it can. Exit 1 when something is wrong.
FIX=0; [ "${1:-}" = --fix ] && FIX=1
PKG=$(cat "$HOME/.config/xmactahoe/package-dir" 2>/dev/null); E="$PKG/extra"; LS="$HOME/.local/share"; bad=0
ok(){ echo "  OK    $1"; }; ko(){ echo "  FAIL  $1"; bad=$((bad+1)); }
[ -d "$E" ] && ok "package copy $PKG" || ko "package copy missing ('$PKG'): re-run install.sh from the full package, or xmactahoe update"
V=$(cat "$HOME/.config/kdedefaults/package" 2>/dev/null)
case "$V" in XMacTahoe.Dark) ok "global theme $V"; KV=XMacTahoeDark; GT=MacTahoe-Dark; IC=XMacTahoe-Night;; XMacTahoe.Light) ok "global theme $V"; KV=XMacTahoe; GT=MacTahoe-Light; IC=XMacTahoe-Day;; *) ko "global theme is '$V'"; [ $FIX = 1 ] && plasma-apply-lookandfeel -a XMacTahoe.Dark >/dev/null 2>&1; KV=XMacTahoeDark; GT=MacTahoe-Dark; IC=XMacTahoe-Night;; esac
for c in "plasmarc:Theme:name:XMacTahoe-" "kdeglobals:Icons:Theme:$IC" "kcminputrc:Mouse:cursorTheme:XMacTahoe-cursors" "kdeglobals:KDE:widgetStyle:kvantum"; do IFS=: read f g k want <<<"$c"; v=$(kreadconfig6 --file "$f" --group "$g" --key "$k"); case "$v" in "$want"*) ok "$f [$g] $k=$v";; *) ko "$f [$g] $k='$v' (expected $want*)";; esac; done
for v in Dark Light; do x=$(kreadconfig6 --file kdeglobals --group KDE --key "Default${v}LookAndFeel"); [ "$x" = "XMacTahoe.$v" ] && ok "Plasma ${v,,} theme $x" || { ko "Plasma ${v,,} theme '$x' (expected XMacTahoe.$v)"; [ $FIX = 1 ] && kwriteconfig6 --file kdeglobals --group KDE --key "Default${v}LookAndFeel" "XMacTahoe.$v"; }; done
v=$(sed -n 's/^theme=//p' "$HOME/.config/Kvantum/kvantum.kvconfig" 2>/dev/null); [ "$v" = "$KV" ] && ok "Kvantum $v" || { ko "Kvantum '$v' (expected $KV)"; [ $FIX = 1 ] && "$HOME/.local/bin/xmactahoe-sync-variant"; }
v=$(sed -n 's/^gtk-theme-name=//p' "$HOME/.config/gtk-3.0/settings.ini" 2>/dev/null); [ "$v" = "$GT" ] && ok "GTK $v" || { ko "GTK '$v' (expected $GT)"; [ $FIX = 1 ] && "$HOME/.local/bin/xmactahoe-sync-variant"; }
for d in "plasma/desktoptheme/XMacTahoe-Dark" "plasma/look-and-feel/XMacTahoe.Dark" "icons/XMacTahoe-Night" "aurorae/themes/XMacTahoe-Night" "wallpapers/XMacTahoe"; do [ -d "$LS/$d" ] && ok "$d present" || ko "$d missing (re-run install.sh)"; done
systemctl --user is-enabled -q xmactahoe-panels.path 2>/dev/null && ok "screen-hotplug unit enabled" || { ko "screen-hotplug unit not enabled (a new screen would get no panels)"; [ $FIX = 1 ] && { cp "$E"/systemd/xmactahoe-panels.* "$HOME/.config/systemd/user/" 2>/dev/null; systemctl --user daemon-reload; systemctl --user enable --now xmactahoe-panels.path; }; }
bare=$("$HOME/.local/bin/xmactahoe-panels" status 2>/dev/null | grep -c "no panel"); [ "${bare:-0}" = 0 ] && ok "every screen has its panels" || { ko "$bare screen(s) without panels"; [ $FIX = 1 ] && "$HOME/.local/bin/xmactahoe-panels" clone; }
systemctl --user is-enabled -q xmactahoe-variant.path 2>/dev/null && ok "variant sync unit enabled" || { ko "variant sync unit not enabled"; [ $FIX = 1 ] && { cp "$E"/systemd/xmactahoe-variant.* "$HOME/.config/systemd/user/" 2>/dev/null; systemctl --user daemon-reload; systemctl --user enable --now xmactahoe-variant.path; }; }
if rpm -q kwin-effect-roundcorners >/dev/null 2>&1; then r=$(gdbus call --session --dest org.kde.KWin --object-path /Effects --method org.kde.kwin.Effects.isEffectLoaded kwin4_effect_shapecorners 2>/dev/null); case "$r" in *true*) ok "rounded corners effect loaded";; *) ko "rounded corners effect not loaded"; [ $FIX = 1 ] && "$E/xmactahoe-round-corners" >/dev/null;; esac; else ko "kwin-effect-roundcorners not installed (extra/xmactahoe-round-corners)"; fi
if systemctl --user is-enabled -q xmactahoe-appearance.timer 2>/dev/null; then
  if [ -s "$HOME/.config/xmactahoe/location" ] || [ -n "$(kreadconfig6 --file kwinrc --group NightColor --key LatitudeAuto 2>/dev/null)" ]; then ok "auto appearance has a location"
  else ko "auto appearance is on but has no location: echo 'LATITUDE LONGITUDE' > ~/.config/xmactahoe/location"; fi
fi
[ -f "$HOME/.config/environment.d/xmactahoe.conf" ] && ok "GTK portal env file" || { ko "GTK portal env file missing"; [ $FIX = 1 ] && { mkdir -p "$HOME/.config/environment.d"; cp "$E/environment.d/xmactahoe.conf" "$HOME/.config/environment.d/"; }; }
[ -x "$HOME/.local/bin/kde-desktop-repair" ] && { "$HOME/.local/bin/kde-desktop-repair" --check >/dev/null 2>&1 && ok "AppGrid shortcuts (Meta, Alt+Space)" || { ko "AppGrid shortcuts need repair"; [ $FIX = 1 ] && "$HOME/.local/bin/kde-desktop-repair" --no-backup >/dev/null 2>&1; }; }
for rc in dolphinrc konsolerc katerc kwriterc okularrc gwenviewrc arkrc spectaclerc systemsettingsrc; do
  v=$(kreadconfig6 --file "$rc" --group UiSettings --key ColorScheme 2>/dev/null)
  if [ -n "$v" ]; then ko "$rc forces its own app color scheme '$v' (unreadable text with the theme)"; [ $FIX = 1 ] && kwriteconfig6 --file "$rc" --group UiSettings --key ColorScheme --delete; fi
done
ok "app color scheme overrides checked"
grep -q '^\[xmactahoe-' "$HOME/.config/kwinrulesrc" 2>/dev/null && { ko "old forced title-bar rules present (double title bars)"; [ $FIX = 1 ] && "$E/xmactahoe-window-rules" >/dev/null; } || ok "no forced title-bar rules"
GM=$(cat "$HOME/.config/xmactahoe/glass" 2>/dev/null || echo frosted); LE=$(gdbus call --session --dest org.kde.KWin --object-path /Effects --method org.freedesktop.DBus.Properties.Get org.kde.kwin.Effects loadedEffects 2>/dev/null)
case "$GM" in
  liquid)  echo "$LE" | grep -q "'glass'" && ! echo "$LE" | grep -q "'blur'" && ok "glass mode liquid (Glass effect loaded)" || { ko "glass mode liquid but effects out of sync"; [ $FIX = 1 ] && "$E/xmactahoe-glass" liquid >/dev/null; } ;;
  frosted) echo "$LE" | grep -q "'blur'" && ! echo "$LE" | grep -q "'glass'" && ok "glass mode frosted (KWin blur loaded)" || { ko "glass mode frosted but effects out of sync"; [ $FIX = 1 ] && "$E/xmactahoe-glass" frosted >/dev/null; } ;;
  off)     ok "glass mode off" ;;
esac
gdbus call --session --dest org.kde.KWin --object-path /Scripting --method org.kde.kwin.Scripting.isScriptLoaded xmactahoe-attention 2>/dev/null | grep -q true && ok "dock attention script loaded" || { ko "dock attention script not loaded (dock can stay up while an app requests attention)"; [ $FIX = 1 ] && { mkdir -p "$HOME/.local/share/kwin/scripts"; cp -a "$E/kwin-scripts/xmactahoe-attention" "$HOME/.local/share/kwin/scripts/"; kwriteconfig6 --file kwinrc --group Plugins --key xmactahoe-attentionEnabled true; gdbus call --session --dest org.kde.KWin --object-path /KWin --method org.kde.KWin.reconfigure >/dev/null 2>&1; }; }
[ -x "$HOME/.local/bin/xmactahoe" ] && ok "xmactahoe command" || ko "xmactahoe command missing"
echo; [ $bad = 0 ] && echo "All good." || echo "$bad problem(s)$( [ $FIX = 1 ] && echo ' — fixes applied where possible, re-run to confirm' || echo ' — run: xmactahoe doctor --fix' )"; exit $(( bad > 0 ))
